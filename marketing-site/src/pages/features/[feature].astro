---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { features } from '../../lib/content';
import FeatureSearchGuide from '../../components/FeatureSearchGuide.astro';

export function getStaticPaths() {
  const dedicatedFeaturePages = new Set(['billing', 'gst', 'inventory', 'khata', 'reports']);
  return features
    .filter((feature) => !dedicatedFeaturePages.has(feature.id))
    .map((feature) => ({
      params: { feature: feature.id },
      props: { feature },
    }));
}

const { feature } = Astro.props;
---

<BaseLayout title={`${feature.title} | Apna Galla`} description={feature.description}>
  <div class="feature-hero section">
    <div class="container feature-hero-container">
      <span class="feature-group-badge">{feature.group}</span>
      <h1 class="feature-hero-title">{feature.hero}</h1>
      <p class="feature-hero-subtitle">{feature.description}</p>
    </div>
  </div>

  <section class="feature-details section">
    <div class="container">
      <div class="details-grid">
        <div class="details-content">
          <h2 class="details-title">Capabilities included:</h2>
          <ul class="capabilities-list" role="list">
            {feature.cover.map((item) => (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="check-icon">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div class="details-preview">
          <div class="preview-mockup">
            <!-- Simplified mockup placeholder -->
            <div class="mockup-header">
              <span class="mockup-dot"></span>
              <span class="mockup-dot"></span>
              <span class="mockup-dot"></span>
            </div>
            <div class="mockup-body">
              <h3 class="mockup-title">{feature.title} Preview</h3>
              <p class="mockup-note">This is a sample workflow illustrating {feature.title.toLowerCase()} inside Apna Galla.</p>
              <div class="mockup-skeleton"></div>
              <div class="mockup-skeleton short"></div>
              <div class="mockup-skeleton half"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FeatureSearchGuide feature={feature.id} />
  <FinalCTA />
</BaseLayout>

<style>
  .feature-hero {
    background: var(--ag-primary);
    color: var(--ag-primary-on);
    text-align: center;
    border-bottom: 1px solid var(--ag-divider);
  }
  .feature-hero-container {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .feature-group-badge {
    background: var(--ag-primary-container);
    color: var(--ag-primary-on-container);
    font-family: var(--ag-font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--ag-radius-full);
    margin-bottom: 1rem;
  }
  .feature-hero-title {
    font-family: var(--ag-font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .feature-hero-subtitle {
    font-size: 1.125rem;
    color: var(--ag-primary-on-container);
    max-width: 36rem;
  }
  
  .details-grid {
    display: grid;
    gap: 3rem;
  }
  .details-title {
    font-family: var(--ag-font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .capabilities-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .capabilities-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .check-icon {
    color: var(--ag-primary);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  
  .preview-mockup {
    background: var(--ag-surface-low);
    border: 1px solid var(--ag-divider);
    border-radius: var(--ag-radius-xl);
    overflow: hidden;
    box-shadow: var(--ag-shadow-md);
  }
  .mockup-header {
    background: var(--ag-surface-high);
    padding: 0.75rem 1rem;
    display: flex;
    gap: 0.375rem;
    border-bottom: 1px solid var(--ag-divider);
  }
  .mockup-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--ag-outline-variant);
  }
  .mockup-body {
    padding: 2rem;
    background: var(--ag-surface-lowest);
  }
  .mockup-title {
    font-family: var(--ag-font-heading);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .mockup-note {
    font-size: 0.875rem;
    color: var(--ag-text-secondary);
    margin-bottom: 1.5rem;
  }
  .mockup-skeleton {
    height: 1rem;
    background: var(--ag-surface-container);
    border-radius: var(--ag-radius-sm);
    margin-bottom: 0.75rem;
  }
  .mockup-skeleton.short { width: 75%; }
  .mockup-skeleton.half { width: 50%; }

  @media (min-width: 768px) {
    .feature-hero-title {
      font-size: 3rem;
    }
    .details-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
