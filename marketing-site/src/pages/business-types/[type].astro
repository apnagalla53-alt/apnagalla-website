---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { businessTypes } from '../../lib/content';
import { businessSearch } from '../../lib/shop-search';
import ShopFaq from '../../components/ShopFaq.astro';

export function getStaticPaths() {
  return businessTypes.map((type) => ({
    params: { type: type.id },
    props: { type },
  }));
}

const { type } = Astro.props;
const guide=businessSearch[type.id];
---

<BaseLayout title={`${type.name} Billing & Khata Software | Apna Galla`} description={`Manage ${type.name} shop billing, customer khata, supplier dues and stock with Apna Galla. Explore relevant workflows and create an account for a demo.`}>
  <div class="type-hero section">
    <div class="container type-hero-container">
      <div class="type-icon">{type.icon}</div>
      <h1 class="type-hero-title">{type.name} Software</h1>
      <p class="type-hero-subtitle">
        Tailored features like {type.tags.slice(0, 3).join(', ')} to run your {type.name.toLowerCase()} efficiently.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="tags-grid">
        {type.tags.map(tag => (
          <div class="tag-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tag-icon">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <h3 class="tag-title">{tag}</h3>
            <p class="tag-desc">Integrated seamlessly into your daily workflow.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {guide&&<><section class="section"><div class="container business-guide"><h2>Billing, stock and hisaab for a {type.name.toLowerCase()} shop</h2><p>{guide.intro}</p><p>Basic billing and khata remain straightforward. Advanced units, variants, GST, photos and serial/warranty features have their respective plan requirements. <a href="/pricing/">Compare plans</a> before choosing a workflow.</p><a href={guide.guide}>Read the related shopkeeper guide →</a></div></section><ShopFaq items={[{question:guide.question,answer:guide.answer}]}/></>}
  <FinalCTA />
</BaseLayout>

<style>
  .business-guide{max-width:54rem;line-height:1.9}.business-guide h2{font:800 1.7rem var(--ag-font-heading);margin-bottom:1rem}.business-guide p{margin:1rem 0;color:var(--ag-text-secondary)}.business-guide a{color:var(--ag-primary);text-decoration:underline;text-underline-offset:4px}
  .type-hero {
    background: var(--ag-surface-lowest);
    text-align: center;
    border-bottom: 1px solid var(--ag-divider);
  }
  .type-hero-container {
    max-width: 48rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .type-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    background: var(--ag-surface-low);
    width: 6rem;
    height: 6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: var(--ag-shadow-sm);
  }
  .type-hero-title {
    font-family: var(--ag-font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .type-hero-subtitle {
    font-size: 1.125rem;
    color: var(--ag-text-secondary);
  }
  
  .tags-grid {
    display: grid;
    gap: 1.5rem;
    max-width: 64rem;
    margin-inline: auto;
  }
  .tag-card {
    background: var(--ag-surface-lowest);
    border: 1px solid var(--ag-divider);
    border-radius: var(--ag-radius-lg);
    padding: 1.5rem;
    box-shadow: var(--ag-shadow-sm);
  }
  .tag-icon {
    color: var(--ag-primary);
    margin-bottom: 1rem;
  }
  .tag-title {
    font-family: var(--ag-font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    text-transform: capitalize;
  }
  .tag-desc {
    font-size: 0.875rem;
    color: var(--ag-text-secondary);
  }

  @media (min-width: 640px) {
    .tags-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .tags-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
