---
import BaseLayout from '../layouts/BaseLayout.astro';
import AccountAccess from '../components/AccountAccess.astro';
---

<BaseLayout title="Sign In | Apna Galla" description="Sign in to your Apna Galla account.">
  <div class="auth-wrapper section">
    <div class="container auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <a href="/" class="auth-logo-link" aria-label="Apna Galla Home">
            <img src="/logo.webp" alt="Apna Galla" width="160" height="130" class="auth-logo-img" />
          </a>
          <h1 class="auth-title">Welcome back to Apna Galla</h1>
          <p class="auth-subtitle">One account for your website and shop software.</p>
        </div>
        
        <div class="auth-actions">
          <AccountAccess/>
        </div>
        
        <div class="auth-footer">
          <p>Don't have an account? <a href="/signup">Sign up</a></p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-wrapper {
    min-height: 80vh;
    display: flex;
    align-items: center;
    background: var(--ag-surface);
  }
  .auth-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .auth-card {
    width: 100%;
    max-width: 28rem;
    background: var(--ag-surface-lowest);
    border: 1px solid var(--ag-divider);
    border-radius: var(--ag-radius-xl);
    padding: 2.5rem;
    box-shadow: var(--ag-shadow-md);
  }
  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .auth-logo-link {
    display: inline-block;
    margin-bottom: 1.25rem;
    transition: transform 0.2s ease;
  }
  .auth-logo-link:hover {
    transform: scale(1.03);
  }
  .auth-logo-img {
    width: 9.5rem;
    height: auto;
    object-fit: contain;
    margin: 0 auto;
  }
  .auth-title {
    font-family: var(--ag-font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .auth-subtitle {
    font-size: 0.9375rem;
    color: var(--ag-text-secondary);
    line-height: 1.5;
  }
  .auth-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .btn-block {
    width: 100%;
    height: 3rem;
  }
  .auth-footer {
    text-align: center;
    font-size: 0.875rem;
    color: var(--ag-text-secondary);
  }
  .auth-footer a {
    color: var(--ag-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .auth-footer a:hover {
    text-decoration: underline;
  }
</style>
