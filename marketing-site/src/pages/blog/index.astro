---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts, postUrl, displayDate } from '../../lib/blog';
const posts=await publishedPosts();
---
<BaseLayout title="Dukaan Hisaab, Billing & Khata Guides | Apna Galla" description="Practical shopkeeper guides for billing, bahi-khata, udhaar, stock, daily galla and vyapaar hisaab. English with useful Hindi/Hinglish explanations.">
 <section class="section"><div class="container guide-wrap"><p class="guide-kicker">THE SHOPKEEPER'S NOTEBOOK</p><h1>Dukaan ka hisaab, explained simply.</h1><p class="guide-intro">Real questions about billing, khata, stock and daily cash. Step-by-step examples in English, with Hindi/Hinglish explanations you can use at the counter.</p><div class="guide-links"><a href="/glossary/">Hisaab glossary →</a><a href="/rss.xml">Subscribe through RSS →</a><a href="/editorial-policy/">How we prepare guides →</a></div>
 <div class="guide-grid">{posts.map(post=><article class="guide-card"><span>{post.data.category}</span><h2><a href={postUrl(post.id)}>{post.data.title}</a></h2><p>{post.data.description}</p><time datetime={post.data.published}>{displayDate(post.data.published)}</time><a class="guide-read" href={postUrl(post.id)}>Read the guide →</a></article>)}</div>
 <aside class="guide-cta"><h2>Put the routine to work in your shop.</h2><p>Explore Apna Galla's billing, stock and khata workflows, then create your account for a demo.</p><a class="btn btn-primary" href="/signup/">Create account &amp; get demo</a></aside></div></section>
</BaseLayout>
<style>.guide-wrap{max-width:76rem}.guide-kicker{font-size:.75rem;letter-spacing:.12em;font-weight:800;color:var(--ag-primary)}h1{font:800 clamp(2rem,5vw,3.5rem)/1.15 var(--ag-font-heading);max-width:20ch;margin:1rem 0}.guide-intro{max-width:48rem;font-size:1.1rem;line-height:1.8;color:var(--ag-text-secondary)}.guide-links{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;margin:1.5rem 0 2.5rem}.guide-links a,.guide-read{color:var(--ag-primary);text-decoration:underline;text-underline-offset:4px}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem}.guide-card{display:flex;flex-direction:column;gap:1rem;background:var(--ag-surface-lowest);border:1px solid var(--ag-divider);padding:1.5rem;border-radius:20px}.guide-card>span{font-size:.75rem;font-weight:800;color:var(--ag-primary)}.guide-card h2{font:800 1.2rem/1.5 var(--ag-font-heading)}.guide-card h2 a{color:inherit}.guide-card p{line-height:1.75;color:var(--ag-text-secondary)}.guide-card time{font-size:.8rem;color:var(--ag-text-secondary);margin-top:auto}.guide-cta{background:var(--ag-surface-low);padding:2rem;border-radius:24px;margin-top:3rem}.guide-cta h2{font:800 1.5rem var(--ag-font-heading);margin-bottom:1rem}.guide-cta p{margin-bottom:1.5rem;line-height:1.8}@media(max-width:950px){.guide-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.guide-grid{grid-template-columns:1fr}.guide-cta{padding:1.3rem}}</style>
