---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopFaq from '../../components/ShopFaq.astro';
import { publishedPosts, postUrl, displayDate } from '../../lib/blog';
import { SITE, canonicalUrl } from '../../lib/seo';
export async function getStaticPaths(){return (await publishedPosts()).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;
const {Content,headings}=await render(post), url=canonicalUrl(postUrl(post.id));
const published=post.data.published,modified=post.data.updated||post.data.published;
const others=(await publishedPosts()).filter(p=>p.id!==post.id).sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category)).slice(0,3);
const structuredData=[{'@type':'BlogPosting','@id':url+'#article',headline:post.data.title,description:post.data.description,datePublished:published,dateModified:modified,inLanguage:'en-IN',articleSection:post.data.category,image:[SITE+'/og-image.png'],mainEntityOfPage:{'@id':url+'#webpage'},author:{'@type':'Organization',name:'Apna Galla',url:SITE+'/editorial-policy/'},publisher:{'@id':SITE+'/#organization'}}, {'@type':'FAQPage','@id':url+'#faq',mainEntity:post.data.faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}];
---
<BaseLayout title={`${post.data.title} | Apna Galla`} description={post.data.description} structuredData={structuredData} article={{published,modified,section:post.data.category}}>
 <article class="guide-article section"><div class="container article-wrap"><nav class="article-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Shopkeeper guides</a></nav><p class="article-category">{post.data.category}</p><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><p class="article-meta">By <a href="/editorial-policy/">Apna Galla</a> · <time datetime={post.data.published}>{displayDate(post.data.published)}</time>{post.data.updated&&post.data.updated!==post.data.published&&<> · Updated <time datetime={post.data.updated}>{displayDate(post.data.updated)}</time></>}</p><p class="article-question">Your question: <strong>{post.data.primaryQuestion}</strong></p>
 <details class="article-toc"><summary>In this guide</summary><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol></details><div class="article-body"><Content/></div>
 <aside class="article-note">Examples are illustrative, not customer records. This guide was prepared with AI assistance and checked against the documented product workflows. <a href="/editorial-policy/">Read our editorial policy.</a></aside>
 <section class="article-tools"><h2>Explore the related workflows</h2><ul>{post.data.related.map(link=><li><a href={link}>{link.split('/').filter(Boolean).at(-1)?.replace(/-/g,' ')} →</a></li>)}</ul></section>
 </div></article>
 <ShopFaq items={post.data.faqs}/>
 <section class="section"><div class="container article-wrap"><h2 class="related-title">Keep learning</h2><ul class="related-guides">{others.map(p=><li><a href={postUrl(p.id)}>{p.data.title} →</a></li>)}</ul><div class="article-cta"><h2>Bring a clearer hisaab to your shop.</h2><a class="btn btn-primary" href="/signup/">Create account &amp; get demo</a></div></div></section>
</BaseLayout>
<style>.article-wrap{max-width:52rem}.article-crumbs{display:flex;gap:.6rem;flex-wrap:wrap;font-size:.85rem;margin-bottom:2rem}.article-crumbs a,.article-meta a,.article-body :global(a),.article-note a,.article-tools a,.related-guides a,.article-toc a{color:var(--ag-primary);text-decoration:underline;text-underline-offset:4px}.article-category{font-weight:800;font-size:.8rem;color:var(--ag-primary)}h1{font:800 clamp(1.9rem,4.5vw,3.1rem)/1.2 var(--ag-font-heading);margin:1rem 0;overflow-wrap:anywhere}.article-description{font-size:1.1rem;line-height:1.8;color:var(--ag-text-secondary)}.article-meta{font-size:.85rem;line-height:1.8;margin:1.3rem 0}.article-question{background:var(--ag-surface-low);padding:1.2rem;border-radius:16px;line-height:1.8}.article-toc{padding:1.3rem 0;border-bottom:1px solid var(--ag-divider);margin-bottom:2rem}.article-toc summary{cursor:pointer;min-height:30px;font-weight:800}.article-toc ol{padding-left:1.2rem;line-height:2;margin-top:.8rem}.article-body{font-size:1rem;line-height:1.9;overflow-wrap:anywhere}.article-body :global(h2){font:800 clamp(1.3rem,3vw,1.75rem)/1.4 var(--ag-font-heading);margin:2.3rem 0 1rem;scroll-margin-top:7rem}.article-body :global(p),.article-body :global(ul),.article-body :global(ol){margin:1rem 0}.article-body :global(ul),.article-body :global(ol){padding-left:1.4rem}.article-body :global(li){margin:.45rem 0}.article-body :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:1.5rem 0}.article-body :global(th),.article-body :global(td){padding:.8rem;text-align:left;border:1px solid var(--ag-divider)}.article-body :global(th){background:var(--ag-surface-low)}.article-body :global([lang=hi]){padding:1rem;border-left:3px solid var(--ag-primary);background:var(--ag-surface-low);border-radius:0 12px 12px 0}.article-note{font-size:.8rem;line-height:1.8;border-top:1px solid var(--ag-divider);padding-top:1.4rem;margin-top:2rem;color:var(--ag-text-secondary)}.article-tools{margin-top:2rem}.article-tools h2,.related-title,.article-cta h2{font:800 1.4rem/1.5 var(--ag-font-heading)}.article-tools ul,.related-guides{display:grid;gap:1rem;margin:1rem 0;list-style:none}.article-tools a{text-transform:capitalize}.article-cta{padding:2rem;background:var(--ag-surface-low);border-radius:22px;margin-top:3rem;display:grid;gap:1.3rem}.article-cta .btn{justify-self:start}@media(max-width:480px){.article-cta{padding:1.2rem}.article-body :global(th),.article-body :global(td){padding:.6rem;font-size:.9rem}}</style>
