---
import { features } from '../lib/content';

const iconMap: Record<string, string> = {
  'receipt': '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path>',
  'book': '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>',
  'package': '<line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line>',
  'wallet': '<path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"></path><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"></path><path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z"></path>',
  'chart': '<line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line>',
  'message-circle': '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>',
};
---

<section class="features-section section" aria-labelledby="features-heading">
  <div class="container">
    <div class="features-header">
      <span class="features-eyebrow">Engineered for Bharat</span>
      <h2 id="features-heading" class="features-title">Everything Your Dukan Needs to Grow</h2>
      <p class="features-subtitle">
        Built specifically for Kirana, Supermarkets, Garments, Electronics & Hardware merchants.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature) => (
        <a href={`/features/${feature.id}`} class="feature-card">
          <div class="feature-icon-wrapper">
            <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconMap[feature.icon] || ''} />
          </div>
          <div class="feature-content">
            <h3 class="feature-title">
              {feature.title}
              {feature.status === 'coming-soon' && (
                <span class="badge badge-status-coming ml-2">Coming Soon</span>
              )}
            </h3>
            <p class="feature-desc">{feature.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    background: var(--ag-surface-lowest);
  }

  .features-header {
    text-align: left;
    margin-bottom: 2.5rem;
    max-width: 48rem;
  }

  .features-eyebrow {
    font-family: var(--ag-font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ag-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .features-title {
    font-family: var(--ag-font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ag-text);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .features-subtitle {
    font-size: 1rem;
    color: var(--ag-text-secondary);
    line-height: 1.5;
  }

  .features-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-card {
    background: var(--ag-surface-low);
    border: 1px solid var(--ag-divider);
    border-radius: var(--ag-radius-lg);
    padding: 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    box-shadow: var(--ag-shadow-sm);
  }

  .feature-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--ag-secondary-container);
    color: var(--ag-primary);
    border-radius: var(--ag-radius);
    flex-shrink: 0;
  }

  .feature-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .feature-title {
    font-family: var(--ag-font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ag-text);
    margin-bottom: 0.25rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-desc {
    font-size: 0.875rem;
    color: var(--ag-text-secondary);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .features-title {
      font-size: 2.25rem;
    }
    .features-subtitle {
      font-size: 1.125rem;
    }
    .features-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .feature-card {
      padding: 1.5rem;
      gap: 1.25rem;
    }
    .feature-icon-wrapper {
      width: 3rem;
      height: 3rem;
    }
    .feature-icon {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
</style>
