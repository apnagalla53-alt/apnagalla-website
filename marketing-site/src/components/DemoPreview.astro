<div class="demo-preview" data-demo aria-labelledby="demo-title">
  <div class="demo-top"><span>● TRY IT YOURSELF</span><span>Sample shop · browser demo</span></div>
  <h2 id="demo-title">Your shop. Try the whole flow.</h2>
  <p class="demo-intro">Add an item → make a bill → see your khata and stock update.</p>
  <div class="demo-tabs" role="tablist" aria-label="Explore sample shop">
    {['bill', 'items', 'khata', 'stock'].map((tab, i) => <button type="button" id={`demo-${tab}-tab`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`demo-${tab}`} tabindex={i === 0 ? 0 : -1} data-tab={tab}>{['Make a bill', 'Add item', 'Khata', 'Stock'][i]}</button>)}
  </div>
  <p data-demo-status role="status" aria-live="polite" class="demo-status">Tea + milk = ₹180. Generate the bill to update your shop.</p>
  <section id="demo-bill" role="tabpanel" aria-labelledby="demo-bill-tab" data-panel="bill">
    <div class="demo-heading"><h3>New bill</h3><button type="button" data-action="clear-cart" class="demo-link">Clear bill</button></div>
    <div data-cart></div>
    <form data-form="cart" class="demo-add-line"><label>Choose item<select name="item" aria-label="Item for bill" required></select></label><label>Quantity<input name="quantity" type="number" min="1" max="100000" step="1" value="1" required /></label><button class="demo-button" type="submit">Add to bill</button></form>
    <form data-form="bill">
      <label>Customer name<input name="customer" maxlength="60" placeholder="Walk-in, or name for udhaar" autocomplete="off" /></label>
      <label>Payment<select name="method"><option value="CASH">Cash · paid</option><option value="UPI">UPI · paid</option><option value="UDHAAR">Udhaar · pay later</option></select></label>
      <div class="demo-total"><span>Bill total</span><output data-cart-total>₹180</output></div>
      <button class="demo-button demo-primary demo-full" type="submit" data-generate>Generate bill →</button>
    </form>
    <div data-receipt hidden class="demo-issued"><div class="demo-heading"><h3>Bill generated</h3><button type="button" class="demo-link" data-action="print">Print / Save PDF</button></div><article data-receipt-paper class="demo-receipt"></article><p class="demo-hint">Sample receipt, using the software’s itemised bill format. Not a tax invoice.</p></div>
    <details class="demo-history"><summary>Previous bills <span data-bill-count>0</span></summary><div data-bill-history></div></details>
  </section>
  <section id="demo-items" role="tabpanel" aria-labelledby="demo-items-tab" data-panel="items" hidden>
    <h3>Create an item</h3><p class="demo-hint">Opening quantity is your existing stock. Purchases are recorded in Stock.</p>
    <form data-form="item"><label>Item name<input name="name" maxlength="60" placeholder="e.g. Basmati rice · 1 kg" required /></label><div class="demo-two"><label>Selling price (₹)<input name="price" inputmode="decimal" placeholder="120.50" required /></label><label>Opening quantity<input name="stock" type="number" min="0" max="100000" step="1" value="10" required /></label></div><button class="demo-button demo-primary demo-full" type="submit">Create item & add 1 to bill</button></form>
    <div data-item-list></div>
  </section>
  <section id="demo-khata" role="tabpanel" aria-labelledby="demo-khata-tab" data-panel="khata" hidden>
    <div class="demo-total"><span>Customer udhaar</span><output data-customer-total>₹0</output></div><div data-accounts></div>
    <form data-form="receive"><h3>Receive a payment</h3><label>Customer<select name="customer" aria-label="Customer paying" required></select></label><div class="demo-two"><label>Amount (₹)<input name="amount" inputmode="decimal" placeholder="Amount received" required /></label><label>Received by<select name="method"><option value="CASH">Cash</option><option value="UPI">UPI</option></select></label></div><button type="submit" class="demo-button demo-primary demo-full">Record payment</button></form>
    <details data-manual-debt><summary>Add existing udhaar</summary><p class="demo-hint">Record an older balance. This does not sell an item or change stock.</p><form data-form="debt"><label>Customer name<input name="customer" maxlength="60" required /></label><label>Amount (₹)<input name="amount" inputmode="decimal" required /></label><label>Note<input name="note" maxlength="120" placeholder="e.g. Opening udhaar" required /></label><button type="submit" class="demo-button demo-full">Add udhaar</button></form></details>
    <h3 class="demo-spaced">Khata history</h3><div data-khata-history></div>
  </section>
  <section id="demo-stock" role="tabpanel" aria-labelledby="demo-stock-tab" data-panel="stock" hidden>
    <h3>Available stock</h3><p class="demo-hint">A draft does not reduce stock. Generated bills do.</p><div data-stock-list></div>
    <details data-purchases><summary>Buy stock / supplier khata</summary><form data-form="purchase"><label>Restock item<select name="item" aria-label="Item to restock" required></select></label><div class="demo-two"><label>Quantity<input name="quantity" type="number" min="1" max="100000" step="1" value="5" required /></label><label>Cost per unit (₹)<input name="cost" inputmode="decimal" required /></label></div><label>Supplier name<input name="supplier" maxlength="60" placeholder="e.g. Sharma Wholesale" required /></label><label>Payment<select name="method"><option value="UDHAAR">Supplier credit · pay later</option><option value="CASH">Cash</option><option value="UPI">UPI</option></select></label><button type="submit" class="demo-button demo-primary demo-full">Record purchase & update stock</button></form><div data-supplier-list></div><form data-form="supplier"><h3>Pay a supplier</h3><label>Supplier<select name="supplier" aria-label="Supplier to pay" required></select></label><div class="demo-two"><label>Amount (₹)<input name="amount" inputmode="decimal" required /></label><label>Pay by<select name="method"><option value="CASH">Cash</option><option value="UPI">UPI</option></select></label></div><button type="submit" class="demo-button demo-full">Record supplier payment</button></form></details>
  </section>
  <div class="demo-footer"><span>Sample data stays in this browser tab. No real payments or messages. Opening cash: ₹1,000.</span><button type="button" class="demo-link" data-action="reset">Reset demo</button></div>
  <div data-reset-confirm hidden class="demo-reset"><p>Clear your sample bills, items and balances?</p><button type="button" class="demo-button" data-action="reset-confirm">Yes, reset sample shop</button><button type="button" class="demo-link" data-action="reset-cancel">Keep my demo</button></div>
  <noscript><p>Enable JavaScript to try the sample shop, or <a href="/signup">create your account</a>.</p></noscript>
</div>
<script>import '../scripts/shop-demo';</script>
<style is:global>
  .demo-preview{width:100%;max-width:40rem;padding:1.5rem;background:#fff;border:1px solid #dce8e1;color:#18352a;border-radius:1.4rem;box-shadow:0 24px 64px #00180c33;text-align:left;font-size:.85rem}
  .demo-top,.demo-heading,.demo-footer{display:flex;justify-content:space-between;align-items:center;gap:.75rem}.demo-top{font-size:.65rem;color:#536b5e}.demo-top span:first-child{font-weight:800;color:#1b6c4d;letter-spacing:.04em}.demo-preview h2{font:800 1.45rem var(--ag-font-heading);letter-spacing:-.03em;margin:1rem 0 .5rem}.demo-preview h3{font:700 .9rem var(--ag-font-heading);margin:.5rem 0}.demo-intro,.demo-hint{color:#617566;line-height:1.6;font-size:.75rem}.demo-tabs{display:flex;gap:4px;background:#eff4f0;padding:4px;border-radius:12px;margin:1rem 0 .7rem}.demo-tabs button{flex:1;min-height:42px;border:0;background:transparent;border-radius:9px;color:#476153;font:600 .77rem var(--ag-font-body);cursor:pointer}.demo-tabs [aria-selected=true]{background:#fff;color:#166440;box-shadow:0 2px 6px #203f2510}.demo-status{border-radius:9px;background:#edf7ef;padding:.7rem;font-size:.75rem;line-height:1.5;margin-bottom:.7rem}.demo-status[data-error=true]{background:#fff0e9;color:#9f3420}.demo-preview form{display:grid;gap:.7rem;margin:.8rem 0}.demo-preview label{display:flex;flex-direction:column;gap:.35rem;font-size:.73rem;font-weight:600}.demo-preview input,.demo-preview select{width:100%;min-width:0;min-height:42px;border:1px solid #cfddd3;border-radius:8px;padding:.6rem;background:#fff;color:#18352a;font:inherit}.demo-two{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.demo-add-line{grid-template-columns:minmax(0,1fr) 5rem auto;align-items:end}.demo-button{min-height:42px;border:1px solid #cfddd3;border-radius:9px;padding:.6rem .8rem;background:#edf4ef;color:#176544;cursor:pointer;font:700 .77rem var(--ag-font-body)}.demo-primary{background:#00513a;border-color:#00513a;color:white}.demo-full{width:100%}.demo-link{border:0;background:none;color:#176544;text-decoration:underline;text-underline-offset:3px;font:600 .73rem var(--ag-font-body);cursor:pointer;min-height:40px}.demo-preview button:disabled{opacity:.45;cursor:default}.demo-preview :is(button,input,select,summary):focus-visible{outline:2px solid #217754;outline-offset:3px}.demo-line{display:flex;justify-content:space-between;gap:.75rem;align-items:center;padding:.85rem 0;border-bottom:1px solid #e5eee7}.demo-line>span{min-width:0;overflow-wrap:anywhere}.demo-line small{display:block;color:#657569;font-size:.7rem;margin-top:.3rem;line-height:1.5}.demo-quantity{display:flex;align-items:center;gap:.3rem}.demo-quantity button{height:36px;width:32px;border:1px solid #d8e5dc;background:#f4f8f5;border-radius:8px;color:#176544;cursor:pointer;font-size:1rem}.demo-quantity input{width:3.5rem;min-height:36px;padding:.3rem;text-align:center}.demo-line-money{text-align:right;white-space:nowrap}.demo-total{display:flex;align-items:center;justify-content:space-between;margin:1rem 0 .5rem}.demo-total output{font:800 1.7rem var(--ag-font-heading);color:#176544}.demo-preview details{border-top:1px solid #e5eee7;margin-top:1rem;padding-top:.85rem}.demo-preview summary{cursor:pointer;font-weight:700;font-size:.8rem;min-height:40px}.demo-footer{border-top:1px solid #e5eee7;margin-top:1rem;padding-top:.8rem;font-size:.66rem;color:#617566;line-height:1.6}.demo-footer span{max-width:26rem}.demo-preview [hidden]{display:none!important}.demo-issued{background:#f3f7f2;padding:1rem;margin-top:1rem;border-radius:12px}.demo-receipt{background:white;border:1px dashed #b4cbb9;max-width:25rem;margin:.5rem auto;padding:1rem;font:12px/1.6 monospace;color:#17281e;overflow-wrap:anywhere}.demo-receipt header{text-align:center;border-bottom:1px dashed #b4cbb9;padding-bottom:.6rem;margin-bottom:.6rem}.demo-receipt h4{font-size:18px;margin:0}.demo-receipt table{width:100%;border-collapse:collapse;table-layout:fixed;margin:.6rem 0}.demo-receipt th,.demo-receipt td{padding:.35rem .15rem;vertical-align:top;text-align:right}.demo-receipt th:first-child,.demo-receipt td:first-child{text-align:left;width:38%}.demo-receipt .receipt-total{display:flex;justify-content:space-between;border-top:1px dashed #b4cbb9;padding-top:.5rem;font-size:15px;font-weight:800}.demo-receipt footer{text-align:center;margin-top:.7rem;font-size:10px}.demo-low{color:#a45c12}.demo-spaced{margin-top:1.2rem!important}.demo-empty{padding:.75rem 0;color:#617566;font-size:.75rem}.demo-reset{background:#fff4df;padding:.8rem;border-radius:9px}.demo-history button{width:100%;text-align:left}.demo-transaction{font-size:.75rem}.demo-transaction small{display:block;color:#657569;margin:.2rem 0}.demo-account{display:flex;gap:.5rem;align-items:center}.demo-account button{white-space:nowrap}.demo-preview .demo-hint{margin:.35rem 0}
  .demo-preview{scroll-margin-top:6rem}.demo-total output{max-width:65%;overflow-wrap:anywhere;text-align:right}.demo-line-money{max-width:100%;white-space:normal;overflow-wrap:anywhere}
  @media(max-width:480px){.demo-preview{padding:1rem}.demo-top{font-size:.58rem}.demo-preview h2{font-size:1.2rem}.demo-add-line{grid-template-columns:minmax(0,1fr) 5rem}.demo-add-line button{grid-column:1/-1}.demo-line{flex-wrap:wrap}.demo-quantity{margin-left:auto}.demo-footer{align-items:flex-start}.demo-account{flex-wrap:wrap}}
  @media print{body.demo-printing>*{display:none!important}body.demo-printing [data-print-receipt]{display:block!important;position:static;width:80mm;padding:5mm;margin:0;color:black;background:white;font:12px/1.6 monospace}body.demo-printing [data-print-receipt] table{width:100%;table-layout:fixed}body.demo-printing [data-print-receipt] :is(th,td){padding:4px;text-align:right;overflow-wrap:anywhere}body.demo-printing [data-print-receipt] :is(th,td):first-child{text-align:left;width:38%}body.demo-printing [data-print-receipt] header,body.demo-printing [data-print-receipt] footer{text-align:center}body.demo-printing [data-print-receipt] .receipt-total{display:flex;justify-content:space-between;border-top:1px dashed;font-size:15px;font-weight:bold}}
</style>
