<section class="preview-section section" aria-labelledby="preview-heading">
  <div class="container preview-container">
    <div class="preview-header"><span class="preview-eyebrow">THE SAME SHOP, LIVE</span><h2 id="preview-heading">Make a bill above. See the change here.</h2><p>Cash, customer udhaar and stock move together. Try a payment or a purchase — this dashboard uses your sample shop.</p></div>
    <div class="preview-app-card" aria-label="Live sample shop dashboard">
      <div class="galla-strip app-card"><div><span class="app-label">Cash in hand (Galla)</span><output class="app-value" data-summary="cash">₹1,000</output><span class="app-subtext">Opening cash ₹1,000 + cash received − cash paid</span></div><span class="ledger-badge">● Live demo ledger</span></div>
      <div class="app-split">
        <div class="app-card"><span class="app-label warning">Customer udhaari</span><output class="app-value" data-summary="due">₹0</output><span class="app-subtext" data-pending-customers>0 customers pending</span><button type="button" class="app-button reminder" data-demo-action="reminder">Preview WhatsApp reminder ↗</button></div>
        <div class="app-card"><span class="app-label">Supplier dena</span><output class="app-value" data-summary="suppliers">₹0</output><span class="app-subtext">Credit purchases − supplier payments</span><button type="button" class="app-button" data-demo-action="suppliers" aria-expanded="false" aria-controls="demo-supplier-panel">View supplier ledger</button></div>
      </div>
      <div class="app-metrics"><div><span>Sales generated</span><strong data-summary="sales">₹0</strong></div><div><span>UPI net received</span><strong data-summary="upi">₹0</strong></div><div><span>Bills made</span><strong data-summary="bills">0</strong></div></div>
      <div class="app-actions"><button type="button" class="app-button primary" data-demo-action="bill">+ New bill</button><button type="button" class="app-button" data-demo-action="debt">+ Add udhaar</button><button type="button" class="app-button" data-demo-action="receive">+ Receive</button></div>
      <div id="demo-supplier-panel" data-supplier-panel hidden class="supplier-panel"><div class="supplier-heading"><h3>Supplier purchases & payments</h3><button type="button" class="app-button" data-demo-action="purchase">+ Buy stock / pay supplier</button></div><p>Record a purchase in the Stock tab. Supplier credit appears here until you record its payment.</p><div data-supplier-history></div></div>
      <p class="preview-note">All actions use the interactive shop above. UPI is tracked separately from cash. This demo does not contact customers or move real money.</p>
    </div>
    <dialog data-reminder aria-labelledby="demo-reminder-title"><div class="reminder-heading"><h3 id="demo-reminder-title">Preview your payment reminder</h3><button type="button" class="app-button" data-demo-action="close-reminder" aria-label="Close reminder">✕</button></div><p>A friendly Hinglish reminder. Nothing is sent from this demo.</p><label>Customer<select aria-label="Reminder customer"></select></label><label>Message<textarea rows="5" readonly aria-label="Reminder message"></textarea></label><button type="button" class="app-button primary" data-demo-action="copy-reminder">Copy reminder</button><p data-copy-status role="status"></p></dialog>
    <noscript><p>Enable JavaScript to try the live demo dashboard.</p></noscript>
  </div>
</section>
<style>
 .preview-section{background:var(--ag-surface-lowest)}.preview-container{max-width:48rem;display:flex;flex-direction:column;gap:2rem}.preview-eyebrow{font-size:.7rem;font-weight:800;color:var(--ag-primary);letter-spacing:.09em}.preview-header h2{font:700 clamp(1.5rem,3vw,2.25rem)/1.3 var(--ag-font-heading);letter-spacing:-.03em;color:var(--ag-text);margin:.6rem 0}.preview-header p{font-size:1rem;color:var(--ag-text-secondary);line-height:1.7}.preview-app-card{background:var(--ag-surface-low);border:1px solid #dce8e1;border-radius:var(--ag-radius-xl);padding:1.25rem;box-shadow:var(--ag-shadow-md);display:grid;gap:.8rem}.app-card{background:#fff;border-radius:var(--ag-radius-lg);padding:1rem;display:flex;flex-direction:column;gap:.25rem;box-shadow:var(--ag-shadow-sm)}.galla-strip{flex-direction:row;justify-content:space-between;gap:.6rem}.app-label{font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--ag-secondary);display:block}.app-label.warning{color:var(--ag-tertiary)}.app-value{display:block;font:700 clamp(1.4rem,3vw,2rem) var(--ag-font-mono);color:var(--ag-text);overflow-wrap:anywhere}.app-subtext{display:block;font-size:.68rem;color:var(--ag-secondary);line-height:1.5}.ledger-badge{font-size:.6rem;color:#166440;background:#e4f5e9;padding:.4rem .6rem;border-radius:20px;white-space:nowrap;height:max-content}.app-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:.75rem}.app-button{display:flex;align-items:center;justify-content:center;gap:.4rem;font:700 .74rem var(--ag-font-body);border:0;border-radius:9px;min-height:44px;padding:.6rem .75rem;background:var(--ag-surface-high);color:var(--ag-text);cursor:pointer}.app-card .app-button{margin-top:.7rem}.app-button:hover{filter:brightness(.97)}.app-button:focus-visible{outline:2px solid var(--ag-primary);outline-offset:3px}.app-button.primary{background:var(--ag-primary);color:#fff}.app-button.reminder{background:var(--ag-tertiary-fixed);color:var(--ag-tertiary-on-fixed)}.app-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem}.app-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem;padding:.6rem}.app-metrics span{display:block;font-size:.63rem;color:#617566}.app-metrics strong{display:block;font-size:1rem;overflow-wrap:anywhere;margin-top:.4rem}.preview-note{font-size:.69rem;color:#617566;line-height:1.7}.supplier-panel{background:white;padding:1rem;border-radius:12px}.supplier-panel[hidden]{display:none}.supplier-heading{display:flex;justify-content:space-between;gap:.6rem;align-items:center}.supplier-heading h3{font-size:.9rem}.supplier-panel p{font-size:.75rem;color:#617566;line-height:1.6}dialog{border:1px solid #dce8e1;border-radius:18px;width:min(90vw,30rem);max-height:85dvh;overflow:auto;padding:1.4rem;box-shadow:0 24px 80px #00180c44;color:#18352a}dialog::backdrop{background:#00180c99}.reminder-heading{display:flex;justify-content:space-between;gap:1rem;align-items:center}.reminder-heading h3{font-size:1rem}dialog p{font-size:.77rem;color:#617566;line-height:1.6;margin:.7rem 0}dialog label{display:grid;gap:.4rem;font-size:.75rem;margin:.8rem 0}dialog textarea,dialog select{width:100%;padding:.7rem;border:1px solid #cfddd3;border-radius:8px;font:inherit;line-height:1.6;background:white;color:#18352a}dialog .primary{width:100%}
 @media(max-width:480px){.preview-app-card{padding:.8rem}.galla-strip{flex-direction:column}.ledger-badge{align-self:flex-start}.app-card{padding:.8rem}.app-split .app-button{font-size:.66rem}.app-actions .app-button{font-size:.67rem;padding:.5rem}.supplier-heading{align-items:flex-start;flex-direction:column}}
</style>
